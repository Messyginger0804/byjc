{
  "ci": {
    "collect": {
      "url": [
        "https://byjc.dev",
        "https://byjc.dev/blogs",
        "https://byjc.dev/portfolio"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "is-crawlable": "error",
        "unused-javascript": [
          "warn",
          {
            "maxLength": 1
          }
        ],
        "uses-optimized-images": "warn",
        "uses-responsive-images": "warn",
        "render-blocking-resources": "warn",
        "color-contrast": "warn",
        "errors-in-console": "warn",
        "inspector-issues": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
